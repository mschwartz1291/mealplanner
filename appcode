<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Family Meal Planner</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { min-height: 100vh; background: #FAFAF7; font-family: Georgia, serif; }

header {
  background: #1A1A2E; padding: 32px 24px 24px; text-align: center;
  background-image: radial-gradient(ellipse at 30% 50%, rgba(255,152,0,0.15), transparent 60%),
                    radial-gradient(ellipse at 70% 50%, rgba(33,150,243,0.1), transparent 60%);
}
header .emoji { font-size: 36px; margin-bottom: 4px; }
header h1 { color: #fff; font-size: 26px; font-weight: 400; font-style: italic; letter-spacing: 0.05em; margin-bottom: 4px; }
header p { color: rgba(255,255,255,0.5); font-size: 13px; font-family: sans-serif; text-transform: uppercase; letter-spacing: 0.08em; }

#app { padding: 24px 16px; max-width: 680px; margin: 0 auto; }

#apiKeySection { background: #fff; border: 2px solid #1A1A2E; border-radius: 12px; padding: 24px; margin-bottom: 24px; }
#apiKeySection h2 { font-size: 16px; font-style: italic; margin-bottom: 8px; color: #1A1A2E; }
#apiKeySection p { font-size: 13px; color: #666; font-family: sans-serif; margin-bottom: 14px; line-height: 1.5; }
#apiKeySection a { color: #2196F3; }
.key-row { display: flex; gap: 8px; }
#apiKeyInput { flex: 1; border: 1.5px solid #DDD; border-radius: 8px; padding: 10px 14px; font-size: 14px; font-family: monospace; outline: none; }
#apiKeyInput:focus { border-color: #1A1A2E; }
#saveKeyBtn { background: #1A1A2E; color: #fff; border: none; border-radius: 8px; padding: 10px 18px; font-size: 14px; cursor: pointer; font-family: sans-serif; white-space: nowrap; }

#welcome { text-align: center; padding: 32px 0; display: none; }
#welcome p { color: #666; font-size: 15px; margin-bottom: 24px; line-height: 1.6; }
.btn-primary { background: #1A1A2E; color: #fff; border: none; border-radius: 8px; padding: 16px 36px; font-size: 16px; cursor: pointer; font-family: Georgia, serif; font-style: italic; letter-spacing: 0.04em; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }

.pantry-box { background: #fff; border: 1.5px solid #E0E0E0; border-radius: 12px; padding: 20px; margin-bottom: 24px; text-align: left; }
.pantry-box label { font-family: sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #999; display: block; margin-bottom: 8px; }
.pantry-box textarea { width: 100%; border: 1.5px solid #E0E0E0; border-radius: 8px; padding: 10px 12px; font-size: 14px; font-family: sans-serif; color: #333; resize: vertical; min-height: 80px; outline: none; line-height: 1.5; }
.pantry-box textarea:focus { border-color: #1A1A2E; }
.pantry-box p { font-family: sans-serif; font-size: 12px; color: #BBB; margin-top: 8px; line-height: 1.5; }

#loading { text-align: center; padding: 60px 0; display: none; }
#loading .spin { font-size: 40px; display: inline-block; animation: spin 2s linear infinite; margin-bottom: 16px; }
#loading p { color: #888; font-family: sans-serif; font-size: 14px; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

#errorBox { background: #FEE; border-radius: 8px; padding: 16px; color: #C00; font-family: sans-serif; font-size: 13px; margin-bottom: 16px; line-height: 1.5; display: none; }

#planSection { display: none; }

.view-toggle { display: flex; gap: 8px; margin-bottom: 20px; }
.view-btn { flex: 1; padding: 10px; border: 1.5px solid #E0E0E0; border-radius: 8px; background: #fff; font-family: sans-serif; font-size: 13px; cursor: pointer; color: #555; }
.view-btn.active { background: #1A1A2E; color: #fff; border-color: #1A1A2E; font-weight: 600; }
#overviewSection { display: block; }
#detailSection { display: none; }

.section-header { font-family: sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 10px; }

#mealPrepSection { margin-bottom: 20px; display: none; }
.prep-step { display: flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,0.06); font-family: sans-serif; font-size: 14px; color: #333; line-height: 1.5; }
.prep-check { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #DDD; flex-shrink: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 11px; margin-top: 1px; transition: all 0.15s; }
.prep-check.done { background: #4CAF50; border-color: #4CAF50; color: white; }
.prep-text.done { text-decoration: line-through; color: #BBB; }

#favSection { margin-bottom: 20px; }
.fav-empty { font-family: sans-serif; font-size: 13px; color: #BBB; font-style: italic; padding: 8px 0; }
.fav-chip { display: inline-flex; align-items: center; gap: 6px; background: #FFF0F5; border: 1.5px solid #FF6B9D; border-radius: 20px; padding: 5px 12px; font-size: 13px; color: #CC4477; margin: 4px 4px 4px 0; font-family: sans-serif; }
.fav-remove { cursor: pointer; color: #FF6B9D; font-size: 15px; line-height: 1; background: none; border: none; padding: 0; }

.overview-grid { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
.overview-card { background: #fff; border-radius: 12px; border: 1.5px solid #EEE; padding: 14px 16px; display: flex; align-items: center; gap: 14px; cursor: pointer; }
.overview-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.overview-day { font-family: sans-serif; font-size: 12px; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: 0.06em; min-width: 36px; }
.overview-meal { flex: 1; }
.overview-name { font-size: 15px; font-style: italic; color: #111; margin-bottom: 2px; }
.overview-prep-time { font-family: sans-serif; font-size: 12px; color: #AAA; }
.overview-actions { display: flex; align-items: center; gap: 6px; }
.like-btn { background: none; border: 1.5px solid #EEE; border-radius: 20px; padding: 4px 10px; font-size: 13px; cursor: pointer; color: #999; }
.like-btn.liked { background: #FFF0F5; border-color: #FF6B9D; color: #FF6B9D; }
.overview-swap { background: none; border: 1.5px solid #EEE; border-radius: 20px; padding: 4px 10px; font-size: 12px; cursor: pointer; color: #999; font-family: sans-serif; }

.day-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 20px; }
.day-tab { flex: 0 0 auto; border: 1.5px solid #E0E0E0; border-radius: 20px; padding: 7px 14px; font-size: 13px; cursor: pointer; font-family: sans-serif; background: #fff; color: #333; }
.day-tab.active { background: #1A1A2E; color: #fff; border-color: #1A1A2E; font-weight: 600; }
#dayCard { border-radius: 16px; overflow: hidden; margin-bottom: 20px; border: 2px solid #eee; }
.card-header { padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; }
.card-header span { color: #fff; font-weight: 700; font-size: 16px; font-family: sans-serif; }
.swap-btn { background: rgba(255,255,255,0.2); color: #fff; border: 1px solid rgba(255,255,255,0.4); border-radius: 6px; padding: 5px 12px; font-size: 12px; cursor: pointer; font-family: sans-serif; }
.tab-bar { display: flex; border-bottom: 1px solid rgba(0,0,0,0.08); }
.tab-btn { flex: 1; padding: 12px; background: transparent; border: none; font-size: 13px; font-family: sans-serif; cursor: pointer; color: #666; border-bottom: 2px solid transparent; }
.tab-btn.active { background: rgba(255,255,255,0.7); font-weight: 600; color: #111; }
.tab-content { padding: 20px; }
.dinner-name { font-size: 20px; font-weight: 600; font-style: italic; color: #111; margin-bottom: 6px; }
.prep-badge { display: inline-block; border-radius: 4px; padding: 2px 8px; font-size: 12px; font-family: sans-serif; margin-bottom: 12px; }
.dinner-desc { color: #444; font-size: 15px; line-height: 1.65; margin-bottom: 12px; font-family: sans-serif; }
.toddler-tip { background: #FFF8E1; border-left: 3px solid #FFC107; border-radius: 0 8px 8px 0; padding: 10px 14px; font-size: 13px; font-family: sans-serif; color: #555; margin-bottom: 12px; }
.toddler-tip strong { color: #F57F17; }
.leftovers-note { padding: 10px 14px; background: rgba(255,255,255,0.6); border-radius: 8px; font-size: 13px; font-family: sans-serif; color: #666; }
.recipe-toggle { margin-top: 14px; width: 100%; background: transparent; border: 1.5px solid #DDD; border-radius: 8px; padding: 10px; font-size: 13px; cursor: pointer; font-family: sans-serif; color: #555; }
.recipe-box { margin-top: 12px; background: rgba(255,255,255,0.75); border-radius: 10px; padding: 16px; display: none; }
.recipe-box.open { display: block; }
.recipe-section-title { font-family: sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 10px; margin-top: 14px; }
.recipe-section-title:first-child { margin-top: 0; }
.ingredient-row { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid rgba(0,0,0,0.05); font-family: sans-serif; font-size: 14px; }
.ingredient-amount { min-width: 70px; color: #888; font-size: 13px; }
.step-row { display: flex; gap: 12px; padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,0.05); font-family: sans-serif; font-size: 14px; line-height: 1.5; color: #333; }
.step-num { min-width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0; margin-top: 1px; }
.lunch-section-title { font-size: 15px; font-family: sans-serif; color: #888; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 14px; }
.lunch-row { display: flex; align-items: baseline; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,0.06); font-family: sans-serif; }
.lunch-lbl { min-width: 90px; font-size: 12px; color: #999; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
.lunch-val { font-size: 14px; color: #333; }

.grocery-btn { width: 100%; border: 2px solid #1A1A2E; border-radius: 10px; padding: 14px; font-size: 15px; cursor: pointer; font-family: Georgia, serif; font-style: italic; letter-spacing: 0.03em; background: #fff; color: #1A1A2E; }
.grocery-btn.open { background: #1A1A2E; color: #fff; border-radius: 10px 10px 0 0; }
.grocery-panel { background: #fff; border: 2px solid #1A1A2E; border-top: none; border-radius: 0 0 10px 10px; padding: 20px; display: none; }
.grocery-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.grocery-toolbar span { font-family: sans-serif; font-size: 13px; color: #888; }
#copyBtn { background: #1A1A2E; color: #fff; border: none; border-radius: 6px; padding: 7px 14px; font-size: 12px; cursor: pointer; font-family: sans-serif; }
#copyBtn.copied { background: #4CAF50; }
.grocery-cat { margin-bottom: 18px; }
.grocery-cat h4 { font-family: sans-serif; font-size: 11px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 1px solid #EEE; padding-bottom: 6px; margin-bottom: 8px; }
.grocery-item { font-family: sans-serif; font-size: 14px; color: #333; padding: 4px 0; }
.grocery-item::before { content: "• "; color: #CCC; }
.regen-btn { width: 100%; background: transparent; color: #999; border: 1.5px dashed #CCC; border-radius: 10px; padding: 12px; font-size: 13px; cursor: pointer; font-family: sans-serif; margin-top: 16px; }

.share-row { display: flex; gap: 8px; margin-bottom: 16px; }
.share-btn { flex: 1; background: #fff; color: #1A1A2E; border: 1.5px solid #1A1A2E; border-radius: 8px; padding: 10px; font-size: 13px; cursor: pointer; font-family: sans-serif; font-weight: 600; transition: all 0.15s; }
.share-btn:hover { background: #1A1A2E; color: #fff; }
.share-btn.copied { background: #4CAF50; color: #fff; border-color: #4CAF50; }
.print-recipe-btn { margin-top: 14px; width: 100%; background: transparent; border: 1.5px solid #1A1A2E; border-radius: 8px; padding: 10px; font-size: 13px; cursor: pointer; font-family: sans-serif; color: #1A1A2E; font-weight: 600; }

@media print {
  body { background: white; }
  header, #app { display: none; }
  #printArea { display: block !important; }
}
#printArea { display: none; }
</style>
</head>
<body>

<header>
  <div class="emoji">🍽️</div>
  <h1>Family Meal Planner</h1>
  <p>Family of 3 · Toddler-friendly · Quick dinners</p>
</header>

<div id="app">

  <div id="apiKeySection">
    <h2>Enter your Anthropic API Key</h2>
    <p>Your key is stored only in your browser and used only to call the Claude API.<br>
    Get one at <a href="https://console.anthropic.com" target="_blank">console.anthropic.com</a> → API Keys.</p>
    <div class="key-row">
      <input type="password" id="apiKeyInput" placeholder="sk-ant-..." />
      <button id="saveKeyBtn">Save &amp; Continue</button>
    </div>
  </div>

  <div id="welcome">
    <p>Generate a full week of quick dinners with toddler-friendly notes,<br>matching toddler lunches, and a ready-to-shop grocery list.</p>
    <div class="pantry-box">
      <label>🥦 Ingredients on hand</label>
      <textarea id="pantryInput" placeholder="e.g. ground beef, canned tomatoes, bell peppers, chicken thighs, rice..."></textarea>
      <p>Claude will try to incorporate these into this week's meals and leave them off the grocery list.</p>
    </div>
    <button class="btn-primary" id="generateBtn">✨ Generate This Week's Plan</button>
    <div style="margin-top:16px">
      <a href="#" id="changeKeyLink" style="font-family:sans-serif;font-size:12px;color:#BBB;">Change API key</a>
    </div>
  </div>

  <div id="loading">
    <div class="spin">🥘</div>
    <p id="loadingMsg">Crafting your meal plan…</p>
  </div>

  <div id="errorBox"></div>

  <div id="planSection">
    <div class="view-toggle">
      <button class="view-btn active" id="btnOverview">📋 Week Overview</button>
      <button class="view-btn" id="btnDetail">🍽️ Day Detail</button>
    </div>

    <div id="overviewSection">
      <div id="favSection"></div>
      <div class="overview-grid" id="overviewGrid"></div>
      <div id="mealPrepSection"></div>
      <div style="margin-bottom:20px">
        <button class="grocery-btn" id="groceryToggle">🛒 Show Grocery List (Whole Foods)</button>
        <div class="grocery-panel" id="groceryPanel"></div>
      </div>
      <div class="share-row">
        <button class="share-btn" id="shareOverviewBtn">📋 Copy Meal Summary</button>
        <button class="share-btn" id="printWeekBtn">🖨️ Print Weekly Plan</button>
      </div>
      <button class="regen-btn" id="regenBtn">↺ Regenerate entire week</button>
    </div>

    <div id="detailSection">
      <div class="day-tabs" id="dayTabs"></div>
      <div id="dayCard"></div>
      <button class="regen-btn" id="regenBtn2">↺ Regenerate entire week</button>
    </div>
  </div>

</div>

<script>
var PROMPT = [
  "You are a meal planner for a family of 3: 2 adults and a 21-month-old toddler.",
  "",
  "DINNER REQUIREMENTS:",
  "- MAXIMUM SIMPLICITY. Meals must be doable one-handed while chasing a toddler.",
  "  Sheet pan, one-pot, dump-and-go, minimal chopping, mostly hands-off.",
  "  No constant stirring, no precise timing, no multiple simultaneous steps.",
  "- Under 30 minutes active cooking (slow cooker Sunday is fine for long total time).",
  "- Not too spicy. Make great leftovers for adult lunches.",
  "- Toddler loves: dairy-based dips and toppings (sour cream, yogurt, cottage cheese, cream cheese),",
  "  ketchup, pizza, pasta with marinara or tomato sauce, ground beef.",
  "- When making pasta, prefer marinara/tomato-based sauces over cream-based sauces.",
  "  Add a toddlerNote if any adaptation is needed.",
  "",
  "DAY RULES - generate exactly these 5 days in this order:",
  "- Sunday: a hearty, hands-off meal that works well for a relaxed weekend evening",
  "- Monday: simple weeknight meal",
  "- Tuesday: simple weeknight meal",
  "- Wednesday: ALWAYS Breakfast for Dinner (eggs+sausage+potatoes, French toast, or pancakes)",
  "- Thursday: simple weeknight meal",
  "- Do NOT include Friday or Saturday.",
  "",
  "VARIETY RULES:",
  "- Never repeat the same protein, cuisine, or cooking method twice in one week.",
  "- Reuse ingredients across meals where possible to keep the grocery list short,",
  "  but meals must taste and look completely different from each other.",
  "- Be genuinely creative. Think beyond the obvious weeknight defaults.",
  "  Draw from a wide range of cuisines and formats: Mexican, Italian, Asian, American,",
  "  Mediterranean, Greek, Korean, Thai, Indian-inspired, etc.",
  "  Surprise the family with something they might not think to make themselves,",
  "  as long as it stays simple and kid-friendly.",
  "- Imagine you are a creative but practical home cook with a global pantry.",
  "  Every week should feel meaningfully different from the last.",
  "",
  "TODDLER LUNCH - one per day, packed lunch format:",
  "- ALLERGEN RULE (strict): NO eggs, peanuts, tree nuts, sesame, shellfish, soy, or fish",
  "  in any component including mains, sauces, breads, and snacks.",
  "- main: previous dinner leftovers if allergen-free, otherwise safe alternative",
  "  (plain pasta, mini cheese quesadilla on flour tortilla, diced chicken, etc.)",
  "- dairy: alternate between Cottage cheese and Yogurt each day",
  "- cheese: Cheddar cheese",
  "- fruit: berries or similar",
  "- snack: yogurt bites, granola bar, or Cheerios (must be allergen-free)",
  "- carb: waffle or bagel — include on 3-4 days, omit on others",
  "",
  "MEAL PREP - include a mealPrep array of 3-6 practical steps doable on the weekend.",
  "IMPORTANT: meal prep steps must be derived ONLY from the actual ingredients and steps",
  "in the recipes you have already generated above. Do not invent prep steps for",
  "ingredients or techniques that are not in the recipes. For example, if Wednesday",
  "is scrambled eggs, do not suggest hard-boiling eggs. Only suggest prep that",
  "genuinely saves time on the specific recipes chosen, e.g. pre-chopping a vegetable",
  "that appears in multiple recipes, marinating a protein overnight, or pre-cooking",
  "a grain used in a specific dish. Always name the specific day and dish each step applies to.",
  "",
  "Return ONLY valid JSON with no markdown, no extra text, in exactly this format:",
  "{",
  "  \"days\": [{",
  "    \"day\": \"Sunday\",",
  "    \"dinner\": {",
  "      \"name\": \"\", \"description\": \"\", \"prepTime\": \"\",",
  "      \"toddlerNote\": \"\",",
  "      \"ingredients\": [{\"amount\": \"\", \"item\": \"\"}],",
  "      \"steps\": [\"\"]",
  "    },",
  "    \"toddlerLunch\": {",
  "      \"main\": \"\", \"dairy\": \"\", \"cheese\": \"Cheddar cheese\",",
  "      \"fruit\": \"\", \"snack\": \"\", \"carb\": \"\"",
  "    }",
  "  }],",
  "  \"groceryList\": {",
  "    \"Produce\": [], \"Meat & Seafood\": [], \"Dairy & Eggs\": [],",
  "    \"Pantry & Dry Goods\": [], \"Frozen\": [], \"Bread & Bakery\": [],",
  "    \"Snacks & Cereals\": []",
  "  },",
  "  \"mealPrep\": [\"\"]",
  "}"
].join("\n");

var DAY_COLORS  = ["#E8F4FD","#FEF3E2","#E8F8F0","#FDE8F4","#F0E8FE"];
var DAY_ACCENTS = ["#2196F3","#FF9800","#4CAF50","#E91E8C","#9C27B0"];

var apiKey      = "";
var plan        = null;
var activeDay   = 0;
var activeTab   = "dinner";
var groceryOpen = false;
var favorites   = [];

try { favorites = JSON.parse(localStorage.getItem("mealFavs") || "[]"); } catch(e) {}
try { var sk = localStorage.getItem("mealApiKey"); if (sk) apiKey = sk; } catch(e) {}

// ── API ───────────────────────────────────────────────────────────────
async function callClaude(userMsg) {
  var res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": apiKey,
      "anthropic-version": "2023-06-01",
      "anthropic-dangerous-direct-browser-access": "true"
    },
    body: JSON.stringify({
      model: "claude-haiku-4-5-20251001",
      max_tokens: 8000,
      messages: [{ role: "user", content: PROMPT + "\n\n" + userMsg }]
    })
  });
  if (!res.ok) {
    var err = await res.text();
    throw new Error("API " + res.status + ": " + err.slice(0, 200));
  }
  var data = await res.json();
  var raw = (data.content || []).map(function(b) { return b.text || ""; }).join("");
  try { return JSON.parse(raw); } catch(e) {}
  try { return JSON.parse(raw.replace(/^```json\s*/i, "").replace(/```\s*$/i, "").trim()); } catch(e) {}
  var m = raw.match(/\{[\s\S]*\}/);
  if (m) return JSON.parse(m[0]);
  throw new Error("Could not parse response: " + raw.slice(0, 150));
}

// ── Auth ──────────────────────────────────────────────────────────────
function saveKey() {
  var val = document.getElementById("apiKeyInput").value.trim();
  if (!val.startsWith("sk-")) {
    alert("Please enter a valid Anthropic API key (starts with sk-)");
    return;
  }
  apiKey = val;
  try { localStorage.setItem("mealApiKey", val); } catch(e) {}
  document.getElementById("apiKeySection").style.display = "none";
  document.getElementById("welcome").style.display = "block";
}

function changeKey() {
  apiKey = "";
  try { localStorage.removeItem("mealApiKey"); } catch(e) {}
  document.getElementById("welcome").style.display = "none";
  document.getElementById("apiKeySection").style.display = "block";
  document.getElementById("apiKeyInput").value = "";
}

// ── Generate ──────────────────────────────────────────────────────────
async function generatePlan() {
  hideError();
  document.getElementById("welcome").style.display = "none";
  document.getElementById("planSection").style.display = "none";
  document.getElementById("loading").style.display = "block";

  var favLine = favorites.length > 0
    ? " Previously liked meals to include if possible: " + favorites.map(function(f) { return f.name; }).join(", ") + "."
    : "";

  var pantryEl = document.getElementById("pantryInput");
  var pantryVal = pantryEl ? pantryEl.value.trim() : "";
  var pantryLine = pantryVal
    ? " I have these ingredients on hand that should be incorporated where they fit naturally: " + pantryVal + ". Try to use as many as possible across the week's meals. Do NOT include these on the grocery list since I already have them."
    : "";

  try {
    plan = await callClaude("Generate the 5-day meal plan (Sun-Mon-Tue-Wed-Thu)." + favLine + pantryLine + " Return ONLY valid JSON.");
    activeDay = 0;
    activeTab = "dinner";
    renderAll();
    setView("overview");
    document.getElementById("planSection").style.display = "block";
  } catch(e) {
    showError("Error: " + e.message);
    document.getElementById("welcome").style.display = "block";
  } finally {
    document.getElementById("loading").style.display = "none";
  }
}

async function swapDay(idx) {
  var dayName  = plan.days[idx].day;
  var mealName = plan.days[idx].dinner.name;
  try {
    var result = await callClaude(
      "Replace the " + dayName + " dinner. Current meal \"" + mealName + "\" is being swapped." +
      " Return JSON: {\"replacementDay\":{...},\"groceryList\":{...},\"mealPrep\":[...]}"
    );
    plan.days[idx] = result.replacementDay;
    if (result.groceryList) plan.groceryList = result.groceryList;
    if (result.mealPrep)    plan.mealPrep    = result.mealPrep;
    renderAll();
  } catch(e) {
    showError("Swap failed: " + e.message);
  }
}

// ── Render ────────────────────────────────────────────────────────────
function renderAll() {
  renderMealPrep();
  renderFavSection();
  renderOverviewGrid();
  renderDayTabs();
  renderDayCard();
  renderGrocery();
}

function renderMealPrep() {
  var sec = document.getElementById("mealPrepSection");
  if (!sec || !plan || !plan.mealPrep || !plan.mealPrep.length) {
    if (sec) sec.style.display = "none";
    return;
  }
  sec.style.display = "block";
  sec.innerHTML = "<div class=\"section-header\">🥕 Weekend Meal Prep</div>" +
    plan.mealPrep.map(function(step, i) {
      return "<div class=\"prep-step\" id=\"ps" + i + "\">" +
        "<div class=\"prep-check\" onclick=\"togglePrep(" + i + ")\"></div>" +
        "<div class=\"prep-text\">" + step + "</div>" +
      "</div>";
    }).join("");
}

function togglePrep(i) {
  var row = document.getElementById("ps" + i);
  if (!row) return;
  var check = row.querySelector(".prep-check");
  var text  = row.querySelector(".prep-text");
  var done  = check.classList.toggle("done");
  text.classList.toggle("done");
  check.textContent = done ? "✓" : "";
}

function renderFavSection() {
  var sec = document.getElementById("favSection");
  if (!sec) return;
  var header = "<div class=\"section-header\">❤️ Saved Favourites</div>";
  if (favorites.length === 0) {
    sec.innerHTML = header + "<div class=\"fav-empty\">Like a meal to save it — it will influence future suggestions.</div>";
    return;
  }
  sec.innerHTML = header + favorites.map(function(f) {
    return "<span class=\"fav-chip\">❤️ " + f.name +
      " <button class=\"fav-remove\" onclick=\"removeFav('" + esc(f.name) + "')\">×</button></span>";
  }).join("");
}

function renderOverviewGrid() {
  var grid = document.getElementById("overviewGrid");
  if (!grid || !plan) return;
  grid.innerHTML = plan.days.map(function(d, i) {
    var accent = DAY_ACCENTS[i % DAY_ACCENTS.length];
    var liked  = isFav(d.dinner.name);
    return "<div class=\"overview-card\" style=\"border-left:3px solid " + accent + "\" onclick=\"openDayDetail(" + i + ")\">" +
      "<div class=\"overview-dot\" style=\"background:" + accent + "\"></div>" +
      "<div class=\"overview-day\">" + d.day.slice(0, 3) + "</div>" +
      "<div class=\"overview-meal\">" +
        "<div class=\"overview-name\">" + d.dinner.name + "</div>" +
        "<div class=\"overview-prep-time\">⏱ " + d.dinner.prepTime + "</div>" +
      "</div>" +
      "<div class=\"overview-actions\" onclick=\"event.stopPropagation()\">" +
        "<button class=\"like-btn" + (liked ? " liked" : "") + "\" onclick=\"toggleFav('" + esc(d.dinner.name) + "','" + esc(d.dinner.prepTime) + "')\">" + (liked ? "❤️" : "🤍") + "</button>" +
        "<button class=\"overview-swap\" onclick=\"swapDay(" + i + ")\">🔄</button>" +
      "</div>" +
    "</div>";
  }).join("");
}

function renderDayTabs() {
  var container = document.getElementById("dayTabs");
  if (!container || !plan) return;
  container.innerHTML = plan.days.map(function(d, i) {
    return "<button class=\"day-tab" + (i === activeDay ? " active" : "") + "\" onclick=\"selectDay(" + i + ")\">" + d.day.slice(0, 3) + "</button>";
  }).join("");
}

function renderDayCard() {
  var card = document.getElementById("dayCard");
  if (!card || !plan) return;
  var d      = plan.days[activeDay];
  var color  = DAY_COLORS[activeDay  % DAY_COLORS.length];
  var accent = DAY_ACCENTS[activeDay % DAY_ACCENTS.length];

  var ingHtml = (d.dinner.ingredients || []).map(function(ing) {
    return "<div class=\"ingredient-row\"><span class=\"ingredient-amount\">" + ing.amount + "</span><span>" + ing.item + "</span></div>";
  }).join("");

  var stepsHtml = (d.dinner.steps || []).map(function(s, i) {
    return "<div class=\"step-row\"><div class=\"step-num\" style=\"background:" + accent + "\">" + (i + 1) + "</div><div>" + s + "</div></div>";
  }).join("");

  var recipeHtml = ingHtml
    ? "<button class=\"recipe-toggle\" onclick=\"toggleRecipe(this)\">📋 View Recipe &amp; Ingredients</button>" +
      "<div class=\"recipe-box\">" +
        "<div class=\"recipe-section-title\">Ingredients</div>" + ingHtml +
        "<div class=\"recipe-section-title\">Steps</div>" + stepsHtml +
      "</div>"
    : "";

  var lunchItems = [
    ["🍕 Main",   d.toddlerLunch.main],
    ["🥛 Dairy",  d.toddlerLunch.dairy],
    ["🧀 Cheese", d.toddlerLunch.cheese],
    ["🍓 Fruit",  d.toddlerLunch.fruit],
    ["🥨 Snack",  d.toddlerLunch.snack]
  ];
  if (d.toddlerLunch.carb) lunchItems.push(["🥞 Carb", d.toddlerLunch.carb]);

  var lunchHtml = "<div class=\"lunch-section-title\">Toddler Lunch</div>" +
    lunchItems.map(function(r) {
      return "<div class=\"lunch-row\"><span class=\"lunch-lbl\">" + r[0] + "</span><span class=\"lunch-val\">" + r[1] + "</span></div>";
    }).join("");

  var dinnerHtml =
    "<div class=\"dinner-name\">" + d.dinner.name + "</div>" +
    "<div class=\"prep-badge\" style=\"background:" + accent + "22;color:" + accent + "\">⏱ " + d.dinner.prepTime + "</div>" +
    "<div class=\"dinner-desc\">" + d.dinner.description + "</div>" +
    (d.dinner.toddlerNote ? "<div class=\"toddler-tip\"><strong>🧒 Toddler tip: </strong>" + d.dinner.toddlerNote + "</div>" : "") +
    "<div class=\"leftovers-note\">💡 <em>Leftovers make tomorrow's adult lunch</em></div>" +
    recipeHtml +
    (ingHtml ? "<button class=\"print-recipe-btn\" onclick=\"printRecipe(" + activeDay + ")\">🖨️ Print / Share Recipe</button>" : "");

  card.style.background  = color;
  card.style.borderColor = accent + "33";
  card.innerHTML =
    "<div class=\"card-header\" style=\"background:" + accent + "\">" +
      "<span>" + d.day + "</span>" +
      "<button class=\"swap-btn\" onclick=\"swapDay(" + activeDay + ")\">🔄 Swap dinner</button>" +
    "</div>" +
    "<div class=\"tab-bar\">" +
      "<button class=\"tab-btn" + (activeTab === "dinner" ? " active" : "") + "\" onclick=\"selectTab('dinner')\" style=\"" + (activeTab === "dinner" ? "border-bottom-color:" + accent : "") + "\">🍽️ Dinner</button>" +
      "<button class=\"tab-btn" + (activeTab === "lunch"  ? " active" : "") + "\" onclick=\"selectTab('lunch')\"  style=\"" + (activeTab === "lunch"  ? "border-bottom-color:" + accent : "") + "\">🧒 Toddler Lunch</button>" +
    "</div>" +
    "<div class=\"tab-content\">" + (activeTab === "dinner" ? dinnerHtml : lunchHtml) + "</div>";
}

function renderGrocery() {
  if (!plan) return;
  var panel = document.getElementById("groceryPanel");
  if (!panel) return;
  var cats = Object.keys(plan.groceryList).map(function(cat) {
    return "<div class=\"grocery-cat\"><h4>" + cat + "</h4>" +
      plan.groceryList[cat].map(function(item) {
        return "<div class=\"grocery-item\">" + item + "</div>";
      }).join("") +
    "</div>";
  }).join("");
  panel.innerHTML =
    "<div class=\"grocery-toolbar\">" +
      "<span>Copy and paste into your Whole Foods cart</span>" +
      "<button id=\"copyBtn\" onclick=\"copyGrocery()\">📋 Copy all</button>" +
    "</div>" + cats;
}

// ── UI actions ────────────────────────────────────────────────────────
function setView(view) {
  document.getElementById("btnOverview").className = "view-btn" + (view === "overview" ? " active" : "");
  document.getElementById("btnDetail").className   = "view-btn" + (view === "detail"   ? " active" : "");
  document.getElementById("overviewSection").style.display = view === "overview" ? "block" : "none";
  document.getElementById("detailSection").style.display   = view === "detail"   ? "block" : "none";
}

function openDayDetail(i) { activeDay = i; activeTab = "dinner"; setView("detail"); renderDayTabs(); renderDayCard(); }
function selectDay(i)      { activeDay = i; activeTab = "dinner"; renderDayTabs(); renderDayCard(); }
function selectTab(tab)    { activeTab = tab; renderDayCard(); }

function toggleGrocery() {
  groceryOpen = !groceryOpen;
  var btn   = document.getElementById("groceryToggle");
  var panel = document.getElementById("groceryPanel");
  btn.className   = "grocery-btn" + (groceryOpen ? " open" : "");
  btn.textContent = groceryOpen ? "▲ Hide Grocery List" : "🛒 Show Grocery List (Whole Foods)";
  panel.style.display = groceryOpen ? "block" : "none";
}

function toggleRecipe(btn) {
  var open = btn.nextElementSibling.classList.toggle("open");
  btn.textContent = open ? "▲ Hide Recipe" : "📋 View Recipe & Ingredients";
}

function copyGrocery() {
  var text = Object.keys(plan.groceryList).map(function(cat) {
    return cat + ":\n" + plan.groceryList[cat].map(function(i) { return "  • " + i; }).join("\n");
  }).join("\n\n");
  navigator.clipboard.writeText(text).then(function() {
    var btn = document.getElementById("copyBtn");
    btn.textContent = "✓ Copied!";
    btn.className = "copied";
    setTimeout(function() { btn.textContent = "📋 Copy all"; btn.className = ""; }, 2000);
  });
}

// ── Favorites ─────────────────────────────────────────────────────────
function isFav(name) { return favorites.some(function(f) { return f.name === name; }); }

function toggleFav(name, prepTime) {
  if (isFav(name)) {
    favorites = favorites.filter(function(f) { return f.name !== name; });
  } else {
    favorites.push({ name: name, prepTime: prepTime });
  }
  try { localStorage.setItem("mealFavs", JSON.stringify(favorites)); } catch(e) {}
  renderFavSection();
  renderOverviewGrid();
}

function removeFav(name) {
  favorites = favorites.filter(function(f) { return f.name !== name; });
  try { localStorage.setItem("mealFavs", JSON.stringify(favorites)); } catch(e) {}
  renderFavSection();
  renderOverviewGrid();
}

// ── Helpers ───────────────────────────────────────────────────────────
function esc(s)       { return (s || "").replace(/\\/g, "\\\\").replace(/'/g, "\\'"); }
function showError(m) { var e = document.getElementById("errorBox"); e.textContent = m; e.style.display = "block"; }
function hideError()  { document.getElementById("errorBox").style.display = "none"; }

// ── Share functions ───────────────────────────────────────────────────
function shareOverview() {
  if (!plan) return;
  var lines = ["THIS WEEK'S DINNERS", ""];
  plan.days.forEach(function(d) {
    lines.push(d.day.toUpperCase() + ": " + d.dinner.name);
  });
  navigator.clipboard.writeText(lines.join("\n")).then(function() {
    var btn = document.getElementById("shareOverviewBtn");
    btn.textContent = "✓ Copied!";
    btn.classList.add("copied");
    setTimeout(function() { btn.textContent = "📋 Copy Meal Summary"; btn.classList.remove("copied"); }, 2000);
  });
}

function printWeek() {
  if (!plan) return;

  // Build meal overview rows
  var mealRows = plan.days.map(function(d, i) {
    var accent = DAY_ACCENTS[i % DAY_ACCENTS.length];
    return "<tr>" +
      "<td style=\"padding:10px 14px;border-bottom:1px solid #EEE;font-family:sans-serif;font-size:13px;font-weight:700;color:" + accent + ";white-space:nowrap\">" + d.day + "</td>" +
      "<td style=\"padding:10px 14px;border-bottom:1px solid #EEE;font-size:15px;font-style:italic\">" + d.dinner.name + "</td>" +
      "<td style=\"padding:10px 14px;border-bottom:1px solid #EEE;font-family:sans-serif;font-size:12px;color:#AAA;white-space:nowrap\">⏱ " + d.dinner.prepTime + "</td>" +
    "</tr>" +
    "";
  }).join("");

  // Build grocery list columns
  var groceryCols = Object.keys(plan.groceryList).map(function(cat) {
    if (!plan.groceryList[cat].length) return "";
    return "<div style=\"break-inside:avoid;margin-bottom:20px\">" +
      "<div style=\"font-family:sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#999;border-bottom:1px solid #EEE;padding-bottom:6px;margin-bottom:8px\">" + cat + "</div>" +
      plan.groceryList[cat].map(function(item) {
        return "<div style=\"font-family:sans-serif;font-size:14px;color:#333;padding:3px 0\">- " + item + "</div>";
      }).join("") +
    "</div>";
  }).join("");

  // Build meal prep list
  var prepList = (plan.mealPrep || []).map(function(step) {
    return "<div style=\"display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #EEE;font-family:sans-serif;font-size:14px;color:#333\">" +
      "<span style=\"color:#CCC\">□</span><span>" + step + "</span></div>";
  }).join("");

  var html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">" +
    "<title>Weekly Meal Plan</title>" +
    "<style>" +
      "body{font-family:Georgia,serif;max-width:700px;margin:32px auto;padding:0 24px;color:#222;}" +
      "h1{font-size:26px;font-style:italic;margin-bottom:4px;}" +
      "h2{font-size:13px;font-family:sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#999;margin:28px 0 12px;}" +
      "table{width:100%;border-collapse:collapse;margin-bottom:8px;}" +
      ".grocery-grid{columns:2;column-gap:32px;}" +
      "@media print{.no-print{display:none}}" +
    "</style></head><body>" +
    "<p style=\"font-family:sans-serif;font-size:12px;color:#999;margin-bottom:12px\">Weekly Meal Plan</p>" +
    "<h1>🍽️ This Week's Dinners</h1>" +
    "<h2>Meal Overview</h2>" +
    "<table>" + mealRows + "</table>" +
    "<h2>Grocery List</h2>" +
    "<div class=\"grocery-grid\">" + groceryCols + "</div>" +
    (prepList ? "<h2>🥕 Weekend Meal Prep</h2>" + prepList : "") +
    "<div class=\"no-print\" style=\"margin-top:32px;text-align:center\">" +
      "<button onclick=\"window.print()\" style=\"background:#1A1A2E;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:15px;cursor:pointer;font-family:Georgia,serif;font-style:italic\">🖨️ Print / Save as PDF</button>" +
    "</div>" +
    "</body></html>";

  var win = window.open("", "_blank");
  win.document.write(html);
  win.document.close();
}

function printRecipe(idx) {
  var d = plan.days[idx];
  var accent = DAY_ACCENTS[idx % DAY_ACCENTS.length];
  var ingRows = (d.dinner.ingredients || []).map(function(ing) {
    return "<tr><td style=\"color:#888;padding:6px 12px 6px 0;font-size:14px;white-space:nowrap\">" + ing.amount + "</td><td style=\"padding:6px 0;font-size:14px\">" + ing.item + "</td></tr>";
  }).join("");
  var stepRows = (d.dinner.steps || []).map(function(s, i) {
    return "<div style=\"display:flex;gap:14px;padding:10px 0;border-bottom:1px solid #EEE;align-items:flex-start\">" +
      "<div style=\"min-width:26px;height:26px;border-radius:50%;background:" + accent + ";color:white;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0\">" + (i+1) + "</div>" +
      "<div style=\"font-size:15px;line-height:1.6;color:#333;padding-top:3px\">" + s + "</div>" +
    "</div>";
  }).join("");

  var html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">" +
    "<title>" + d.dinner.name + " Recipe</title>" +
    "<style>body{font-family:Georgia,serif;max-width:600px;margin:40px auto;padding:0 24px;color:#222;}" +
    "h1{font-size:28px;font-style:italic;margin-bottom:6px;}" +
    ".badge{display:inline-block;background:" + accent + "22;color:" + accent + ";border-radius:4px;padding:3px 10px;font-size:13px;font-family:sans-serif;margin-bottom:16px;}" +
    ".desc{font-size:15px;line-height:1.7;color:#444;margin-bottom:24px;font-family:sans-serif;}" +
    "h2{font-size:13px;font-family:sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#999;margin-bottom:12px;margin-top:24px;}" +
    "table{width:100%;border-collapse:collapse;margin-bottom:8px;}" +
    ".tip{background:#FFF8E1;border-left:3px solid #FFC107;padding:10px 14px;font-size:13px;font-family:sans-serif;color:#555;margin:16px 0;border-radius:0 6px 6px 0;}" +
    "@media print{.no-print{display:none}}" +
    "</style></head><body>" +
    "<p style=\"font-family:sans-serif;font-size:12px;color:#999;margin-bottom:20px\">" + d.day + " dinner</p>" +
    "<h1>" + d.dinner.name + "</h1>" +
    "<div class=\"badge\">⏱ " + d.dinner.prepTime + "</div>" +
    "<div class=\"desc\">" + d.dinner.description + "</div>" +
    "" +
    "<h2>Ingredients</h2><table>" + ingRows + "</table>" +
    "<h2>Steps</h2>" + stepRows +
    "<p style=\"margin-top:32px;font-family:sans-serif;font-size:12px;color:#CCC\">Generated by Family Meal Planner</p>" +
    "<div class=\"no-print\" style=\"margin-top:24px;text-align:center\">" +
    "<button onclick=\"window.print()\" style=\"background:#1A1A2E;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:15px;cursor:pointer;font-family:Georgia,serif;font-style:italic\">🖨️ Print / Save as PDF</button>" +
    "</div></body></html>";

  var win = window.open("", "_blank");
  win.document.write(html);
  win.document.close();
}

// ── Wire up all buttons ───────────────────────────────────────────────
document.getElementById("saveKeyBtn").onclick    = saveKey;
document.getElementById("generateBtn").onclick   = generatePlan;
document.getElementById("regenBtn").onclick      = generatePlan;
document.getElementById("regenBtn2").onclick     = generatePlan;
document.getElementById("groceryToggle").onclick = toggleGrocery;
document.getElementById("btnOverview").onclick   = function() { setView("overview"); };
document.getElementById("btnDetail").onclick     = function() { setView("detail"); };
